<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/actionbar_down"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:clipChildren="false"
    android:layout_gravity="bottom"
    android:clipToPadding="false">

    <!-- The actual bar background -->
    <View
        android:id="@+id/view_bg"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_actionbar_down"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageView
        android:id="@+id/iv_home"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:elevation="8dp"
        android:padding="14dp"
        android:src="@drawable/ic_home"
        app:layout_constraintBottom_toBottomOf="@id/view_bg"
        app:layout_constraintEnd_toStartOf="@+id/iv_buy_tickets"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/view_bg"
        app:tint="@color/black"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/iv_buy_tickets"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:elevation="8dp"
        android:padding="14dp"
        android:src="@drawable/ic_buy_tickets"
        app:layout_constraintBottom_toBottomOf="@id/view_bg"
        app:layout_constraintEnd_toStartOf="@+id/iv_account"
        app:layout_constraintStart_toEndOf="@+id/iv_home"
        app:layout_constraintTop_toTopOf="@id/view_bg"
        app:tint="@color/black"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/iv_account"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:elevation="8dp"
        android:padding="14dp"
        android:src="@drawable/ic_account"
        app:layout_constraintBottom_toBottomOf="@id/view_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_buy_tickets"
        app:layout_constraintTop_toTopOf="@id/view_bg"
        app:tint="@color/black"
        tools:ignore="ContentDescription" />

</androidx.constraintlayout.widget.ConstraintLayout>